{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*", "https://github.com/*"]
  },
  "permissions": [
    "core:default",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "dialog:default",
    "shell:allow-open",
    "allow-backup-database",
    "allow-restore-database",
    "allow-kill-server",
    "allow-kill-stale-node-servers",
    "allow-exit-for-update",
    "allow-save-report-file"
  ]
}
