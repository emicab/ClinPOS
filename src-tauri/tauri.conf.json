{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClinPOS",
  "version": "1.17.0",
  "identifier": "com.emidev.clinpos",
  "build": {
    "frontendDist": "../dist_tauri",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:next",
    "beforeBuildCommand": "npm run build:next"
  },
  "app": {
    "windows": [
      {
        "title": "ClinPOS",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:* ws://localhost:*; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' http://localhost:* ws://localhost:* https:;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": [
      "../app_standalone/**/*",
      "../prisma/crm_template.db",
      "../prisma/schema.prisma"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/emicab/crm/releases/latest/download/latest.json",
        "https://github.com/emicab/crm/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENENDIwNzlBNTlDNUQ1MTMKUldRVDFjVlptZ2RDemF5WXNuM0VqZ3N0aS80RTY3YTczTFZHSjQ3ditCU3k2ajRzcFArNncvcU8K"
    }
  }
}
