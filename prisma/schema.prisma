generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  logoUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  logoUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  promotionConditions PromotionCondition[]
}

model Product {
  id            Int            @id @default(autoincrement())
  name          String
  sku           String?        @unique
  description   String?
  pricePurchase Decimal
  priceSale     Decimal
  quantityStock Float
  stockMinAlert Float?
  unitType      String?  // null=sin especificar, UNIT, WEIGHT, VOLUME
  isPublicWeb   Boolean  @default(false)
  webCategory   String?
  webUnavailable Boolean @default(false) // el comerciante lo marcó agotado para la tienda web (manual)
  externalSku   String?  // SKU sincronizado con PedidosYa / Rappi
  lastSyncJobId String?  // ID del último job de sincronización de catálogo
  imageUrl      String?
  brandId       Int?
  categoryId    Int?
  supplierId    Int?
  isRecipe      Boolean        @default(false) // producto elaborado: su stock se deriva de los ingredientes
  isIngredient  Boolean        @default(false) // materia prima: oculta, no se vende (solo Recetario)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  category      Category?      @relation(fields: [categoryId], references: [id])
  brand         Brand?         @relation(fields: [brandId], references: [id])
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  SaleItem         SaleItem[]
  purchaseItems    PurchaseItem[]
  comboItems       ComboItem[]
  promotionConditions PromotionCondition[]
  consignmentItems ConsignmentItem[]
  webOrderItems    WebOrderItem[]
  branchStocks     ProductBranchStock[]
  stockTransferItems StockTransferItem[]
  recipeItems      RecipeItem[]     @relation("RecipeProduct")
  recipeIngredientOf RecipeItem[]   @relation("RecipeIngredient")
  costHistory      RecipeCostHistory[]
  modifierGroups   ProductModifierGroup[]
  modifierOptionIngredientOf ProductModifierOption[] @relation("ModifierOptionIngredient")
}

model RecipeItem {
  id           Int      @id @default(autoincrement())
  productId    Int      // producto elaborado
  ingredientId Int      // ingrediente (puede ser otro elaborado: recetas anidadas)
  quantity     Float    // cantidad en la unidad canónica del ingrediente (kg/L/u)
  unitType     String   // UNIT | WEIGHT | VOLUME (validado contra el ingrediente)
  product      Product  @relation("RecipeProduct", fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Product  @relation("RecipeIngredient", fields: [ingredientId], references: [id])

  @@index([productId])
  @@index([ingredientId])
}

// Historial de costo de productos elaborados: snapshot por unidad cuando el
// costo cambia (al recibir compras de ingredientes o guardar la receta).
model RecipeCostHistory {
  id          Int      @id @default(autoincrement())
  productId   Int      // elaborado
  cost        Decimal  // costo por unidad en ese momento
  hasFullCost Boolean  @default(true) // false si algún ingrediente no tenía costo
  source      String   // "purchase" | "recipe_save" | "manual"
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

model Client {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String?
  email        String?  @unique
  phone        String?
  address      String?
  notes        String?
  cuit           String?
  businessName   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  Sale           Sale[]
  accountBalance AccountBalance?
  consignments   Consignment[]

  @@index([firstName, lastName])
}

model Seller {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  email     String?  @unique
  phone     String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sales        Sale[]
  cashRegisters CashRegister[]
}

model Sale {
  id                  Int           @id @default(autoincrement())
  saleDate            DateTime      @default(now())
  totalAmount         Decimal
  paymentType         PaymentType
  notes               String?
  clientId            Int?
  sellerId            Int
  cashRegisterId      Int?
  branchId            Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  discountCodeApplied String?
  promotionsApplied   String?           // JSON: [{promotionId, name, type, discountAmount}]
  creditCardPromotionId Int?
  creditCardPromotion   CreditCardPromotion? @relation(fields: [creditCardPromotionId], references: [id])
  onAccount           Boolean           @default(false)
  seller              Seller            @relation(fields: [sellerId], references: [id])
  client              Client?           @relation(fields: [clientId], references: [id])
  cashRegister        CashRegister?     @relation(fields: [cashRegisterId], references: [id])
  branch              Branch?           @relation(fields: [branchId], references: [id])
  items               SaleItem[]
  invoice             Invoice?
  accountMovements    AccountMovement[]
  status              SaleStatus        @default(COMPLETED)
}

enum SaleStatus {
  COMPLETED
  PENDING
  CANCELLED
}

model SaleItem {
  id                  Int      @id @default(autoincrement())
  quantity            Float
  priceAtSale         Decimal
  purchasePriceAtSale Decimal
  saleId              Int
  productId           Int?
  // Snapshot del nombre del producto al momento de la venta. Permite que el
  // historial conserve el nombre aunque el producto se elimine o se desvincule.
  productName         String?
  modifiers           String?  // JSON snapshot de modificadores/opciones seleccionadas
  product             Product? @relation(fields: [productId], references: [id])
  sale                Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Expense {
  id          Int         @id @default(autoincrement())
  expenseDate DateTime    @default(now())
  description String
  amount      Decimal
  category    String
  paymentType PaymentType
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Combo {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  price       Decimal   // Precio fijo del combo
  imageUrl    String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  items       ComboItem[]
}

model ComboItem {
  id          Int      @id @default(autoincrement())
  comboId     Int
  productId   Int
  quantity    Float    @default(1)
  customPrice Decimal?
  combo   Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Promotion {
  id             Int                   @id @default(autoincrement())
  name           String
  description    String?
  type           String                // BUY_X_GET_Y, SET_DISCOUNT, THRESHOLD
  status         String                @default("ACTIVE")
  discountType   String                // PERCENTAGE, FIXED_AMOUNT
  discountValue  Decimal               // 10 (10%) o 500 ($500)
  minQuantity    Int?                  // Para THRESHOLD/BUY_X_GET_Y
  maxDiscountQty Int?                  // Para BUY_X_GET_Y: máx unidades con descuento
  priority       Int                   @default(0)
  imageUrl       String?
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  conditions     PromotionCondition[]
}

model PromotionCondition {
  id          Int       @id @default(autoincrement())
  promotionId Int
  productId   Int?
  categoryId  Int?
  minQuantity Int       @default(1)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])
  category  Category? @relation(fields: [categoryId], references: [id])
}

model Coupon {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  discountType  String    // PERCENTAGE | FIXED_AMOUNT
  discountValue Decimal
  minPurchase   Decimal   @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?
}

model Supplier {
  id            Int     @id @default(autoincrement())
  name          String  @unique
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  notes         String?

  purchases Purchase[]
  products  Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Purchase {
  id            Int            @id @default(autoincrement())
  purchaseDate  DateTime       @default(now())
  totalAmount   Decimal // Costo total de la compra
  status        PurchaseStatus @default(PENDING) // Estado de la compra
  paymentType   PaymentType? // Medio de pago (efectivo, transferencia, tarjeta, QR)
  invoiceNumber String? // Número de factura del proveedor (opcional)
  notes         String?

  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  items PurchaseItem[] // Los productos comprados en esta transacción

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseItem {
  id                Int     @id @default(autoincrement())
  quantity          Float   // Cantidad pedida
  quantityReceived  Float?  // Cantidad realmente recibida (null si aún no recibido)
  purchasePrice     Decimal // Costo por unidad en esta compra específica

  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

enum PaymentType {
  CASH
  TRANSFER
  CARD
  QR
  OTHER
  ON_ACCOUNT
  MERCADO_PAGO
}

enum PurchaseStatus {
  PENDING
  ORDERED
  RECEIVED
  CANCELLED
}

model DiscountCode {
  id              Int       @id @default(autoincrement())
  code            String    @unique
  discountPercent Decimal   // Porcentaje o valor de descuento (ej: 10.0)
  discountType    String?   @default("PERCENTAGE") // PERCENTAGE | FIXED_AMOUNT
  discountValue   Decimal?  // Valor numérico de descuento ($ o %)
  minPurchase     Decimal?  @default(0) // Compra mínima / Umbral requerido
  validFrom       DateTime?
  validUntil      DateTime?
  maxUses         Int?      // Límite de usos (null = ilimitado)
  currentUses     Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model CashRegister {
  id              Int       @id @default(autoincrement())
  openDate        DateTime  @default(now())
  closeDate       DateTime?
  initialBalance  Decimal   @default(0)
  expectedBalance Decimal?
  actualBalance   Decimal?
  difference      Decimal?
  status          String    @default("OPEN")
  notes           String?
  sellerId        Int?
  seller          Seller?   @relation(fields: [sellerId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  movements       CashMovement[]
  sales           Sale[]
}

model CashMovement {
  id              Int       @id @default(autoincrement())
  cashRegisterId  Int
  type            String    // SALE, EXPENSE, WITHDRAWAL, DEPOSIT, ADJUSTMENT
  paymentType     String?   // CASH, TRANSFER, CARD, QR, OTHER
  sourceId        Int?      // ID de la venta/gasto relacionado
  amount          Decimal   // Positivo = ingreso, Negativo = egreso
  description     String?
  createdAt       DateTime  @default(now())
  cashRegister    CashRegister @relation(fields: [cashRegisterId], references: [id])
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Invoice {
  id             Int      @id @default(autoincrement())
  saleId         Int      @unique
  cae            String
  caeExpiration  DateTime
  invoiceType    String   // "A", "B", "C", "NCA", "NCB", etc.
  invoiceNumber  Int
  pointOfSale    Int
  clientCuit     String?
  clientName     String?
  xmlRequest     String?
  xmlResponse    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model AccountBalance {
  id         Int      @id @default(autoincrement())
  clientId   Int      @unique
  balance    Decimal  @default(0)  // positivo = debe, negativo = a favor
  updatedAt  DateTime @updatedAt
  client     Client   @relation(fields: [clientId], references: [id])
  movements  AccountMovement[]
}

model AccountMovement {
  id               Int            @id @default(autoincrement())
  accountBalanceId Int
  type             String         // SALE_ON_ACCOUNT, PAYMENT, ADJUSTMENT
  amount           Decimal        // positivo = cargó deuda, negativo = pagó
  description      String?
  saleId           Int?           // si el movimiento viene de una venta en cuenta
  createdAt        DateTime       @default(now())
  accountBalance   AccountBalance @relation(fields: [accountBalanceId], references: [id], onDelete: Cascade)
  sale             Sale?          @relation(fields: [saleId], references: [id])
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  role      String   // "ADMIN" | "SUPERVISOR" | "CASHIER"
  pinHash   String   // SHA-256 PIN hash
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatSession {
  id        String        @id @default(cuid())
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id          String      @id @default(cuid())
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String      // user or model
  content     String
  suggestions String?     // Serialized JSON array of suggestions
  createdAt   DateTime    @default(now())
}

model SavedNote {
  id          String   @id @default(cuid())
  title       String
  description String?
  content     String
  createdAt   DateTime @default(now())
}

enum ConsignmentStatus {
  DELIVERED
  SETTLED
  CANCELLED
}

model Consignment {
  id           Int                 @id @default(autoincrement())
  clientId     Int
  client       Client              @relation(fields: [clientId], references: [id])
  status       ConsignmentStatus   @default(DELIVERED)
  notes        String?
  items        ConsignmentItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model ConsignmentItem {
  id               Int         @id @default(autoincrement())
  consignmentId    Int
  productId        Int
  quantityGiven    Float
  quantitySold     Float       @default(0)
  quantityReturned Float       @default(0)
  priceAtGiven     Decimal
  consignment      Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  product          Product     @relation(fields: [productId], references: [id])
}

model CreditCardPromotion {
  id           Int       @id @default(autoincrement())
  bank         String
  installments String
  startDate    DateTime?
  endDate      DateTime?
  notes        String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sales        Sale[]
}

enum WebOrderStatus {
  PENDING_PAYMENT
  PENDING_PREPARATION
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
  PENDING_REVIEW
}

model StoreConfig {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  customDomain    String?
  businessName    String
  description     String?
  logoUrl         String?
  bannerUrl       String?
  primaryColor    String?  @default("#2563eb")
  isWebActive     Boolean  @default(false)
  mpAccessToken   String?
  mpPublicKey     String?
  mpFeePercent    Decimal  @default(0)
  whatsappPhone   String?
  minStockBuffer  Float    @default(1)
  allowPickup       Boolean  @default(true)
  allowDelivery     Boolean  @default(true)
  deliveryFee       Decimal  @default(0)
  minDeliveryAmount Decimal  @default(0)
  businessSector  String   @default("GASTRONOMIA") // GASTRONOMIA | INDUMENTARIA | MINIMARKET | RETAIL_GENERAL
  requireMpForDelivery Boolean @default(true) // Si el pedido es MERCADO_PAGO, exigir pago confirmado antes de preparar
  lat               Float?   // ubicación del local (para zonas de envío por radio)
  lng               Float?
  deliveryZones     String?  // JSON [{name, fromKm, toKm, fee, minAmount}] anillos concéntricos
  openingHours      String?  // JSON [{day, enabled, open, close, breaks:[{start,end}]}]

  // Integración PedidosYa API v2
  peyaEnabled       Boolean  @default(false)
  peyaConnected     Boolean  @default(false) // Indica si se conectó exitosamente vía OAuth
  peyaClientId      String?
  peyaClientSecret  String?
  peyaChainId       String?
  peyaVendorId      String?
  peyaEnv           String   @default("SANDBOX") // "SANDBOX" | "PRODUCTION"
  peyaAutoAccept    Boolean  @default(false)
  peyaOutletStatus  String   @default("OPEN") // "OPEN" | "BUSY" | "CLOSED"
  peyaWebhookSecret String?  // token estático que PeYA manda en Authorization (WebhookKeyAuth)

  // Integración Rappi API
  rappiEnabled      Boolean  @default(false)
  rappiConnected    Boolean  @default(false) // Indica si se conectó exitosamente
  rappiApiKey       String?
  rappiStoreId      String?
  rappiAutoAccept   Boolean  @default(false)
  rappiOutletStatus String   @default("OPEN") // "OPEN" | "BUSY" | "CLOSED"
  rappiWebhookSecret String? // token estático que Rappi manda en Authorization (webhook auth)

  createdAt         DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WebOrder {
  id              Int            @id @default(autoincrement())
  webOrderNumber  String         @unique
  clientName      String
  clientEmail     String?
  clientPhone     String
  shippingAddress String?
  deliveryType    String         // "PICKUP" | "DELIVERY"
  branchId        Int?           // sucursal que despacha/prepara (null = sin asignar)
  paymentMethod   String         // "MERCADO_PAGO" | "CASH_ON_DELIVERY"
  paymentStatus   String         // "PENDING" | "PAID" | "REJECTED"
  status          WebOrderStatus @default(PENDING_PREPARATION)
  totalAmount     Decimal
  mpFeeAmount     Decimal        @default(0)
  subtotalAmount  Decimal        @default(0) // subtotal del carrito (sin envío ni descuento)
  discountAmount  Decimal        @default(0) // descuento aplicado (cupón y/o promos)
  deliveryFee     Decimal        @default(0) // costo de envío a domicilio
  couponCode      String?        // código de descuento usado
  deliveryZone    String?        // nombre de la zona de envío seleccionada
  trackingCode    String?        // código corto para el link público de seguimiento
  origin          String?        // "WEB" | "WHATSAPP" | "PHONE" | "PEDIDOS_YA" | "RAPPI" | "IN_STORE" | "OTHER"
  orderCode       String?        // Código corto para el rider de PeYa (ej: "wxfr-2440-rtbs")
  externalOrderId String?        @unique // ID único original de PedidosYa / Rappi (impide duplicados por reintentos de webhook)
  chainId         String?        // ID de la cadena (PedidosYa)
  vendorId        String?        // ID de la sucursal (PedidosYa / Rappi)
  transportType   String?        // "LOGISTICS_DELIVERY" | "VENDOR_DELIVERY" | "PICKUP"
  promisedFor     DateTime?      // Fecha/hora prometida de entrega por PeYa/Rappi
  acceptedFor     DateTime?      // Fecha/hora estimada de preparación informada
  riderInfo       String?        // JSON con datos del repartidor
  scheduledFor    DateTime?      // Fecha/hora de entrega programada (para aperturas)
  stockReviewNote String?        // motivo de la revisión por falta de stock local (Regla de Oro)
  stockReviewAt   DateTime?      // cuándo se marcó para revisión
  mpPaymentId     String?        // id del pago de Mercado Pago (para devoluciones)
  discountBreakdown String?      // JSON [{kind: COMBO|PROMO|COUPON, name, amount}] para mostrar desglose de descuentos
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           WebOrderItem[]
}

model WebOrderItem {
  id             Int      @id @default(autoincrement())
  webOrderId     Int
  productId      Int
  quantity       Float
  unitPrice      Decimal
  subtotal       Decimal
  modifiers      String?  // JSON snapshot de opciones seleccionadas
  externalItemId String?  // id del item del pedido externo (PeYA items[]._id) para UPDATE_CART futuro
  webOrder       WebOrder @relation(fields: [webOrderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
}

model Branch {
  id            Int                  @id @default(autoincrement())
  name          String
  address       String?
  phone         String?
  isMain        Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  productStocks ProductBranchStock[]
  transfersFrom StockTransfer[]      @relation("SourceBranch")
  transfersTo   StockTransfer[]      @relation("TargetBranch")
  sales         Sale[]
}

model ProductBranchStock {
  productId     Int
  branchId      Int
  quantityStock Float                @default(0)
  minStock      Float?               @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  product       Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch        Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([productId, branchId])
}

model StockTransfer {
  id             Int                 @id @default(autoincrement())
  sourceBranchId Int
  targetBranchId Int
  status         String              @default("COMPLETED")
  notes          String?
  createdByName  String?
  createdAt      DateTime            @default(now())
  sourceBranch   Branch              @relation("SourceBranch", fields: [sourceBranchId], references: [id])
  targetBranch   Branch              @relation("TargetBranch", fields: [targetBranchId], references: [id])
  items          StockTransferItem[]
}

model StockTransferItem {
  transferId       Int
  productId        Int
  productName      String?
  quantity         Float
  receivedQuantity Float?
  transfer         StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id])

  @@id([transferId, productId])
}

// Outbox transaccional: registra operaciones pendientes de subir a la nube.
// Permite trabajar offline y sincronizar después sin perder datos (borrados,
// pedidos web locales, etc.). El payload se re-lee de la DB local al drenar.
model SyncOutbox {
  id        Int      @id @default(autoincrement())
  operation String   // "UPSERT" | "DELETE"
  entity    String   // nombre de la tabla en la nube: Product, ProductBranchStock, WebOrder, Sale, ...
  entityKey String   // id local o referencia única (ej. "12", "WEB-123456")
  status    String   @default("PENDING") // PENDING | DONE | FAILED
  attempts  Int      @default(0)
  lastError String?
  payloadJson String?
  nextAttemptAt DateTime?
  lastAttemptAt DateTime?
  lockedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([status, nextAttemptAt])
  @@index([entity, entityKey, status])
}

// Registro durable de borrados. Evita que un registro eliminado offline
// vuelva a aparecer durante un pull posterior.
model SyncTombstone {
  id        Int      @id @default(autoincrement())
  entity    String
  entityKey String
  deletedAt DateTime @default(now())
  deviceId  String?
  createdAt DateTime @default(now())

  @@unique([entity, entityKey])
  @@index([deletedAt])
}

// Conflictos que no deben resolverse silenciosamente con "último escritor".
model SyncConflict {
  id           Int      @id @default(autoincrement())
  entity       String
  entityKey    String
  localVersion String?
  remoteVersion String?
  localPayload String?
  remotePayload String?
  status       String   @default("OPEN") // OPEN | RESOLVED | IGNORED
  resolution  String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([status])
  @@index([entity, entityKey, status])
}

model ProductModifierGroup {
  id          Int                     @id @default(autoincrement())
  productId   Int
  name        String                  // ej. "Punto de cocción", "Agregados", "Talle", "Color"
  type        String                  @default("MULTI_SELECT") // SINGLE_SELECT | MULTI_SELECT | SIZE_COLOR
  isRequired  Boolean                 @default(false)
  minSelect   Int                     @default(0)
  maxSelect   Int?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  product     Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  options     ProductModifierOption[]

  @@index([productId])
}

model ProductModifierOption {
  id              Int                  @id @default(autoincrement())
  modifierGroupId Int
  name            String               // ej. "Extra Bacon", "A punto", "Talle L"
  priceExtra      Decimal              @default(0)
  colorHex        String?              // ej. "#000000" para swatches de color
  ingredientId    Int?                 // vínculo con ingrediente de Recetario
  ingredientQty   Decimal              @default(1) // cantidad del ingrediente a descontar por unidad vendida
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  modifierGroup   ProductModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  ingredient      Product?             @relation("ModifierOptionIngredient", fields: [ingredientId], references: [id])

  @@index([modifierGroupId])
}

